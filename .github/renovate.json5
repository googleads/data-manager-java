{
    extends: [
        'config:recommended',
        'schedule:earlyMondays',
        ':ignoreUnstable',
    ],
    labels: [
        'dependencies',
    ],
    minimumReleaseAge: '3 days',
    dependencyDashboard: {
        labels: [
            'type: process',
        ],
    },
    packageRules: [
        {
            description: 'Stay on Java 8 compatible versions of Tink (1.19.0+ dropped Java 8)',
            matchPackageNames: [
                'com.google.crypto.tink:tink',
            ],
            allowedVersions: '< 1.19.0',
        },
        {
            description: 'Stay on Java 8 compatible versions of Tink GCP KMS extension (1.11.0+ dropped Java 8)',
            matchPackageNames: [
                'com.google.crypto.tink:tink-gcpkms',
            ],
            allowedVersions: '< 1.11.0',
        },
        {
            description: 'Stay on Java 17 compatible versions of google-java-format (2.0.0+ requires Java 21)',
            matchPackageNames: [
                'com.google.googlejavaformat:google-java-format',
            ],
            allowedVersions: '< 2.0.0',
        },
    ],
    rebaseWhen: 'behind-base-branch',
    semanticCommits: 'enabled',
    vulnerabilityAlerts: {
        labels: [
            'security',
        ],
        minimumReleaseAge: null,
    },
}
